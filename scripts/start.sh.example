#!/bin/bash
# 前台启动。令牌写在 zabbix-ctl.toml，无需再 export。
set -euo pipefail
cd "$(dirname "$0")"

export ZABBIX_CTL_CONFIG="${ZABBIX_CTL_CONFIG:-$PWD/zabbix-ctl.toml}"
if [[ ! -f "$ZABBIX_CTL_CONFIG" ]]; then
  echo "缺少配置文件: $ZABBIX_CTL_CONFIG" >&2
  echo "请先: cp config/zabbix-ctl.toml.example zabbix-ctl.toml 并填写令牌" >&2
  exit 1
fi

exec ./bin/zabbix-ctl
