# 复制为 zabbix-ctl.toml 后填写。令牌可写在本文件；环境变量同名项可覆盖。
# 可选覆盖：ZABBIX_CTL_SERVICE_TOKEN / ZBX_TOKEN_{CODE} / MERIDIANOPS_JOB_TOKEN / MERIDIANOPS_DB_URL

[server]
bind = "127.0.0.1:8090"
# 与 Gateway 的 MERIDIANOPS_ZABBIX_CTL_TOKEN 保持一致
service_token = "change-me"

[database]
url = "mysql://root:password@127.0.0.1:3306/meridianops"
max_connections = 5

[meridianops]
base_url = "http://127.0.0.1:8800"
# 调 Gateway 作业用的 mk- API 令牌；只读联调可留空
job_token = ""
# 作业定义 ID，0 表示按下方名称从 job_definitions 自动匹配
job_start = 0
job_stop = 0
job_restart = 0
job_upgrade = 0
job_rollback = 0
job_start_name = "Zabbix Agent 启动"
job_stop_name = "Zabbix Agent 停止"
job_restart_name = "Zabbix Agent 重启"
job_upgrade_name = "Zabbix Agent 升级"
job_rollback_name = "Zabbix Agent 回滚"

[[zabbix]]
code = "dc1"
name = "主机房 Zabbix"
api_url = "https://zabbix.example/api_jsonrpc.php"
api_token = "change-me"
enabled = true
# 标准模板名。主机缺少其中任一则在治理页标为偏离；留空则只展示已挂模板。
standard_templates = ["Linux by Zabbix agent"]
proxy_stale_secs = 600
queue_warn = 1000
