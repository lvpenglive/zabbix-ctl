export ZABBIX_CTL_SERVICE_TOKEN='change-me'
# CODE 大写，与 toml 里 [[zabbix]] code 对应，例如 dc1 → ZBX_TOKEN_DC1
export ZBX_TOKEN_DC1='change-me'
